generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  memberLabel  String   @default("Numéro de membre")
  logoUrl      String?
  primaryColor String?
  isPlatform   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                User[]
  elections            Election[]
  positions            Position[]
  candidacies          Candidacy[]
  ballots              Ballot[]
  voteRecords          VoteRecord[]
  auditLogs            AuditLog[]
  candidacyConditions  CandidacyCondition[]

  @@index([isPlatform])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ordreNumber    String
  email          String
  firstName      String
  lastName       String
  passwordHash   String
  role           Role         @default(ELECTEUR)
  status         MemberStatus @default(ACTIF)
  isEligible     Boolean      @default(true)
  section        String?
  region         String?
  phone          String?
  photoUrl       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditLogs      AuditLog[]   @relation("ActorLogs")
  candidacies    Candidacy[]
  otps           Otp[]
  voteRecords    VoteRecord[]

  @@unique([organizationId, ordreNumber])
  @@unique([organizationId, email])
  @@index([role])
  @@index([status])
  @@index([organizationId])
}

model Election {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  title           String
  description     String?
  status          ElectionStatus @default(BROUILLON)
  majorityRule    MajorityRule   @default(RELATIVE)
  totalRounds     Int            @default(1)
  currentRound    Int            @default(1)
  startAt              DateTime
  endAt                DateTime
  candidacyStartAt     DateTime?
  candidacyEndAt       DateTime?
  eligibleSection String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  ballots         Ballot[]
  positions       Position[]
  voteRecords     VoteRecord[]

  @@index([status])
  @@index([organizationId])
}

model Position {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  electionId     String
  title          String
  description    String?
  seats          Int          @default(1)
  order          Int          @default(0)
  candidacies    Candidacy[]
  election       Election     @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
  @@index([organizationId])
}

model Candidacy {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  positionId     String
  userId         String
  status         CandidacyStatus @default(SOUMISE)
  profession     String?
  age            Int?
  biography      String?
  photoUrl       String?
  videoUrl       String?
  program        String?
  documentUrl    String?
  reviewNote     String?
  submittedAt    DateTime        @default(now())
  reviewedAt     DateTime?
  position       Position        @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([positionId, userId])
  @@index([status])
  @@index([organizationId])
}

model Ballot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  electionId     String
  round          Int          @default(1)
  ciphertext     String
  iv             String
  authTag        String
  createdAt      DateTime     @default(now())
  election       Election     @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId, round])
  @@index([organizationId])
}

model VoteRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  electionId     String
  userId         String
  round          Int          @default(1)
  votedAt        DateTime     @default(now())
  election       Election     @relation(fields: [electionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([electionId, userId, round])
  @@index([electionId, round])
  @@index([organizationId])
}

model Otp {
  id        String     @id @default(cuid())
  userId    String
  codeHash  String
  purpose   OtpPurpose
  context   String?
  expiresAt DateTime
  consumed  Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorId        String?
  action         String
  entity         String?
  entityId       String?
  meta           Json?
  ip             String?
  createdAt      DateTime      @default(now())
  actor          User?         @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([organizationId])
}

model CandidacyCondition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  text           String
  order          Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

enum Role {
  ELECTEUR
  CANDIDAT
  COMMISSION
  ADMIN
  OBSERVATEUR
  SUPER_ADMIN
}

enum MemberStatus {
  ACTIF
  SUSPENDU
  RADIE
  RETRAITE
}

enum ElectionStatus {
  BROUILLON
  PLANIFIE
  OUVERT
  CLOS
  DEPOUILLE
  PUBLIE
}

enum MajorityRule {
  RELATIVE
  ABSOLUE
}

enum CandidacyStatus {
  SOUMISE
  VALIDEE
  REJETEE
  RETIREE
}

enum OtpPurpose {
  LOGIN
  VOTE
  RESET
}
