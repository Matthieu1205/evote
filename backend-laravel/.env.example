APP_NAME=eVote
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3001

# --- Frontend (CORS) ---
# URL exacte du frontend React. NE PAS utiliser de motif générique en prod.
FRONTEND_URL=http://localhost:5173

# --- Base de données MySQL ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pharmavote
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions ---
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false
# En production cross-site (frontend et API sur domaines différents) : none + secure=true
SESSION_SAME_SITE=lax

# --- Sécurité vote ---
# Clé AES-256-GCM des bulletins : 64 caractères hexadécimaux (32 octets).
# Générer : openssl rand -hex 32
BALLOT_ENCRYPTION_KEY=

# --- OTP ---
# Livraison : "log" (dev, écrit dans laravel.log) ou "email" (SMTP)
OTP_DELIVERY=email
# Ne JAMAIS mettre à true en production : renvoie l'OTP dans la réponse API.
OTP_EXPOSE_CODE=false
# Court-circuite l'OTP à la connexion. Réservé au dev.
OTP_BYPASS=false
# Redirige tous les OTP vers cette adresse (tests).
OTP_OVERRIDE_EMAIL=mathieuadou30@gmail.com

# --- Mail (OTP + notifications) — Gmail SMTP ---
# 1. Active la validation en 2 étapes sur ton compte Google.
# 2. Crée un « mot de passe d'application » (16 caractères) :
#    https://myaccount.google.com/apppasswords
# 3. Colle-le dans MAIL_PASSWORD (sans les espaces) et mets ton adresse Gmail
#    dans MAIL_USERNAME et MAIL_FROM_ADDRESS.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=mathieuadou30@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS="mathieuadou30@gmail.com"
MAIL_FROM_NAME="eVote"

# --- Cloudinary (upload photos/vidéos, optionnel) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

LOG_CHANNEL=stack
LOG_LEVEL=debug
