# === Variables d'environnement — PRODUCTION (Render) ===
# À renseigner dans Render → ton Web Service → Environment. NE PAS committer les vraies valeurs.

APP_NAME=eVote
APP_ENV=production
APP_DEBUG=false
# Généré avec : php artisan key:generate --show
APP_KEY=
# URL publique du backend Render
APP_URL=https://evote-backend.onrender.com

# URL du frontend (Vercel) — pour le CORS. Origine EXACTE, sans slash final.
FRONTEND_URL=https://evote.vercel.app

# --- Base PostgreSQL (Render) ---
DB_CONNECTION=pgsql
# Colle l'« Internal Database URL » fournie par Render (commence par postgres://)
DB_URL=

# --- Hachage : bcrypt en prod (Argon2 pas garanti dans l'image Docker) ---
HASH_DRIVER=bcrypt

# --- Sessions / cache / file ---
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Sécurité vote ---
# 64 caractères hexadécimaux : php -r "echo bin2hex(random_bytes(32));"
BALLOT_ENCRYPTION_KEY=

# --- OTP ---
OTP_DELIVERY=email
OTP_EXPOSE_CODE=false
OTP_BYPASS=false

# --- Email : Resend (API HTTPS, non bloquée par Render) ---
MAIL_MAILER=resend
RESEND_API_KEY=
# Adresse d'expéditeur : un domaine vérifié dans Resend (ou onboarding@resend.dev pour tester)
MAIL_FROM_ADDRESS=no-reply@ton-domaine.com
MAIL_FROM_NAME=eVote

LOG_CHANNEL=stack
LOG_LEVEL=error
